# =============================================================================
# Parade State Management System — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

NODE_ENV=production                         # development | production | test
PORT=3000
APP_BASE_URL=https://your-app-domain.com    # No trailing slash. Used for OAuth redirect URIs.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@host:5432/parade_state
                                            # Full connection string. Takes precedence over individual vars below.

# Alternatively, use individual vars (DATABASE_URL takes precedence if set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=parade_state
# DB_USER=parade_state_app
# DB_PASSWORD=
# DB_SSL=true                              # Require SSL in production

DB_POOL_MIN=2
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# Authentication — Google OAuth 2.0
# Register your app at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: {APP_BASE_URL}/auth/google/callback
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=${APP_BASE_URL}/auth/google/callback

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------

SESSION_SECRET=                             # Strong random string, min 32 chars. Never reuse across environments.
SESSION_MAX_AGE_SECONDS=28800               # 8 hours default

# -----------------------------------------------------------------------------
# Super Admin
# The account whose Google email matches this value is auto-granted super_admin
# role on first sign-in. Cannot be changed via UI; requires redeployment.
# -----------------------------------------------------------------------------

SUPER_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Background Jobs
# Handles scheduled deployment activation/deactivation.
# If using pg-boss, it uses DATABASE_URL. If using BullMQ, configure Redis below.
# -----------------------------------------------------------------------------

JOB_RUNNER=pg-boss                         # pg-boss | bullmq

# Required if JOB_RUNNER=bullmq:
# REDIS_URL=redis://localhost:6379

# Deployment activation check interval (seconds). Only relevant for pg-boss.
DEPLOYMENT_ACTIVATION_POLL_INTERVAL=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=info                              # debug | info | warn | error
LOG_FORMAT=json                             # json | pretty (use pretty for local dev)

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------

MAX_CSV_UPLOAD_BYTES=5242880               # 5 MB; must match app.config.json csvImport.maxFileSizeBytes

# -----------------------------------------------------------------------------
# CORS (if frontend is served from a different origin)
# -----------------------------------------------------------------------------

# CORS_ALLOWED_ORIGINS=https://your-app-domain.com
