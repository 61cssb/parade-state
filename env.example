# Environment: "production" enables hardening (fail-fast secrets, strict
# CORS, Secure cookies, no /docs). Railway is auto-detected as production;
# set this explicitly everywhere else.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/parade_state

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=your-random-session-secret-string-here

# Super Admin (required in production)
SUPER_ADMIN_EMAIL=admin@example.com

# CORS origins allowed to make credentialed requests (comma-separated).
# Required in production; "*" is rejected there.
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Application
APP_BASE_URL=http://localhost:8000
DEBUG=false

# Auth cookie Secure flag. Defaults to true in production (HTTPS-only);
# set false only when testing the production build over plain HTTP locally.
# AUTH_COOKIE_SECURE=true

# Super-admin database restore from the admin UI (/admin/database-restore).
# Set false to disable the UI/API path and require the CLI procedure.
RESTORE_ENABLED=true

# Testing-only: super-admin purge of all nominal rolls and downstream data
# from the admin settings page (/admin/settings); API + UI, audit-logged.
# On in development by default; production must set it explicitly.
PURGE_ENABLED=true

# Feature flags: hide not-yet-ready features entirely (no nav entry; page
# and API routes 404 for every role, including super admins). Default off.
# Development enables them so they stay testable; production leaves them
# unset until the feature ships. Toggling = env-var change + restart.
# Full gating matrix with current dev/prod values: docs/DEPLOYMENT.md.
FEATURE_DEFERMENTS=false   # Deferments: /admin/deferments page, /api/v1/deferments/*, nav entry
FEATURE_GROUPING=false     # Grouping: /grouping pages, /api/v1/groupings/*, nav entry, NR-browser "Create Grouping"
FEATURE_STRENGTH=false     # Unit Strength report at /admin (replaces the old admin dashboard), nav entry

# Core-feature kill switches: emergency OFF switches for the two shipped
# core features — the inverse of the flags above. Default ON: unset (or
# true) means fully available; explicit false hides the feature entirely
# (same gating as above). Toggling = env-var change + restart.
FEATURE_NOMINALROLL=true   # Nominal Roll stack: /nominal-roll + /admin/csv-upload + /admin/taggings pages, /api/v1/nominal-rolls/* + /api/v1/csv/* + /api/v1/taggings/*, nav entries
FEATURE_ATTENDANCE=true    # Attendance: /attendance page, /api/v1/attendance/*, nav entry

# Environment banner: when set, a thin amber strip fixed at the very top
# of every page (including the login screen) shows this text, so users
# never have to read the URL to know which environment they are in.
# The strip is a pure overlay — the page below stays pixel-identical to
# production (its height stays within the topbar's own top padding);
# unset (production) means no markup at all.
# ENVIRONMENT_BANNER=Development environment
